{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "yara",
      "camelcase": "Yara",
      "title": "YARA",
      "scope": "source.yara",
      "file-types": ["yar", "yara"],
      "injection-regex": "^yara$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "YARA rules (YARA 4.5 and YARA-X) for tree-sitter",
    "authors": [{ "name": "Tran Duc Nam", "email": "dynamo.foss@gmail.com" }],
    "links": { "repository": "https://github.com/dynamotn/tree-sitter-yara" }
  }
}
